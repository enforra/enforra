{
  "version": 1,
  "cases": [
    {
      "name": "string contains matching text",
      "operator": "contains",
      "actual": "package_install network_download",
      "value": "network_download",
      "expected": true
    },
    {
      "name": "string contains rejects missing text",
      "operator": "contains",
      "actual": "package_install",
      "value": "secret_read",
      "expected": false
    },
    {
      "name": "string not_contains accepts missing text",
      "operator": "not_contains",
      "actual": "package_install",
      "value": "secret_read",
      "expected": true
    },
    {
      "name": "string not_contains rejects matching text",
      "operator": "not_contains",
      "actual": "package_install secret_read",
      "value": "secret_read",
      "expected": false
    },
    {
      "name": "command signals array contains matching signal",
      "operator": "contains",
      "actual": [
        "package_install",
        "package_mutation",
        "network_download"
      ],
      "value": "package_mutation",
      "expected": true
    },
    {
      "name": "command signals array rejects missing signal",
      "operator": "contains",
      "actual": [
        "file_read",
        "sensitive_path_access",
        "secret_read"
      ],
      "value": "external_transfer",
      "expected": false
    },
    {
      "name": "array not_contains accepts missing scalar",
      "operator": "not_contains",
      "actual": [
        "infra_tool",
        "write_operation"
      ],
      "value": "delete_operation",
      "expected": true
    },
    {
      "name": "array not_contains rejects matching scalar",
      "operator": "not_contains",
      "actual": [
        "infra_tool",
        "delete_operation"
      ],
      "value": "delete_operation",
      "expected": false
    },
    {
      "name": "array membership uses strict scalar equality",
      "operator": "contains",
      "actual": [
        1
      ],
      "value": "1",
      "expected": false
    },
    {
      "name": "boolean array membership does not coerce numbers",
      "operator": "contains",
      "actual": [
        true
      ],
      "value": 1,
      "expected": false
    },
    {
      "name": "contains rejects non-container values",
      "operator": "contains",
      "actual": 42,
      "value": 42,
      "expected": false
    },
    {
      "name": "not_contains rejects non-container values",
      "operator": "not_contains",
      "actual": 42,
      "value": 7,
      "expected": false
    }
  ]
}
